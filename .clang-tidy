# Bug-finding and performance checks; style is left to clang-format. Run by
# the Docker `lint` stage (AGENTS.md). Not enabled:
#   bugprone-easily-swappable-parameters: most functions take several strings.
#   misc-const-correctness, misc-include-cleaner, misc-use-internal-linkage,
#     misc-non-private-member-variables-in-classes: style only.
#   misc-unused-parameters: unfinished functions keep parameters they will use.
#   performance-enum-size: int-sized enums cost nothing here.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  clang-diagnostic-*,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-virtual-class-destructor,
  google-explicit-constructor,
  misc-*,
  -misc-const-correctness,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -misc-unused-parameters,
  -misc-use-internal-linkage,
  modernize-use-nullptr,
  modernize-use-override,
  performance-*,
  -performance-enum-size,
  readability-container-size-empty,
  readability-inconsistent-declaration-parameter-name,
  readability-redundant-string-cstr,
  readability-redundant-string-init
WarningsAsErrors: "*"
# Own headers only; vendored ones (deps/, src/json/) are skipped
HeaderFilterRegex: "(src|test)/iem/"
